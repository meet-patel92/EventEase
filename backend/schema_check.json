components:
  schemas:
    Booking:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        status:
          $ref: '#/components/schemas/BookingStatusEnum'
        total_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        user:
          type: integer
        event:
          type: integer
      required:
      - created_at
      - event
      - id
      - updated_at
      - user
    BookingRequest:
      type: object
      properties:
        status:
          $ref: '#/components/schemas/BookingStatusEnum'
        total_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        user:
          type: integer
        event:
          type: integer
      required:
      - event
      - user
    BookingStatusEnum:
      enum:
      - PENDING
      - CONFIRMED
      - CANCELLED
      - REFUNDED
      type: string
      description: |-
        * `PENDING` - Pending
        * `CONFIRMED` - Confirmed
        * `CANCELLED` - Cancelled
        * `REFUNDED` - Refunded
    DashboardStat:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        value:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
        date:
          type: string
          format: date
          readOnly: true
      required:
      - date
      - id
      - name
    DashboardStatRequest:
