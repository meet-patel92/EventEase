# Copy to backend/.env for local development and replace placeholders locally.
# Do not commit backend/.env or put real credentials in this example.
SECRET_KEY=replace-with-a-long-random-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=eventease_db
DB_USER=replace-with-local-mysql-user
DB_PASSWORD=replace-with-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Use matching test credentials from the Razorpay test-mode dashboard only.
# Replace both placeholders in your local backend/.env; never use rzp_live_ keys here.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here
